// Pas de `@unique` sur `matricule` ici (contrairement au serveur) : un doublon créé hors-ligne sur
// deux postes différents doit pouvoir être écrit localement sans bloquer, et se résout comme une
// erreur métier normale (FAILED, §6.3 du plan) à la synchro plutôt que de bloquer l'écriture locale.
model Employee {
  id               String    @id
  firstName        String
  lastName         String
  role             String
  specialty        String?
  department       String?
  matricule        String?
  contractType     String?
  contractNumber   String?
  hireDate         DateTime?
  contractEndDate  DateTime?
  dailyStatus      String?
  presentDays      Int?
  absentDays       Int?
  lateDays         Int?
  averageHoursMin  Int?
  overtimeHoursMin Int?
  isActive         Boolean   @default(true)
  serverUpdatedAt  DateTime?
  syncStatus       String    @default("SYNCED")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Copie locale de l'abonnement Pandora signé (Plan-Site-Pandora.md §6.4) : permet de contrôler
// l'abonnement hors connexion. `maxSeenAt` = date la plus récente jamais vue sur ce poste — si
// l'horloge du poste recule en dessous, on ne la croit pas (protection contre le recul de l'heure).
model LocalSubscription {
  id        String   @id
  payload   String
  signature String
  maxSeenAt DateTime
  updatedAt DateTime @updatedAt

  @@map("local_subscription")
}
