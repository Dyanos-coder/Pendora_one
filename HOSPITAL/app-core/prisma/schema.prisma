// Pandora Health — dupliqué depuis app-core (Pandora One Core)
// Schéma de données local (SQLite via libSQL). Voir Architecture-App-PC-Multitenant.md §4.1/§4.4.
//
// Le backend distant (HOSPITAL/app-server + MySQL) est la source de vérité pour l'identité
// (une instance = un établissement, voir modèle Company côté serveur) — la base locale ne
// garde donc que le journal d'audit local.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

// Journal append-only (§3.8) : le service audit.service.ts n'expose volontairement
// aucune méthode update/delete sur ce modèle. userId référence un utilisateur qui vit côté
// serveur distant, pas de contrainte de clé étrangère locale.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  createdAt  DateTime @default(now())
}

// --- Mode hors-ligne — Phase 0 (voir Plan-Mode-Hors-Ligne-Synchronisation.md) -------------------
// Fondations transverses uniquement : aucun domaine métier n'écrit encore ici (ça, c'est la
// Phase 1). `operation`/`status` sont des String plutôt que des enum Prisma — le connecteur
// SQLite ne supporte pas les enums natifs, contrairement à MySQL côté app-server.

// Une ligne par action utilisateur en attente d'envoi vers app-server (pattern outbox).
// `operation` ∈ CREATE | UPDATE | DELETE. `status` ∈ PENDING | SENDING | SENT | FAILED.
// `payload` est le corps JSON tel qu'il sera envoyé à la fonction remote-api.client.ts
// correspondante ; `entityId` est l'id (UUID généré côté client, voir §4 du plan) de l'entité
// locale concernée.
model SyncOutbox {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  operation  String
  payload    String
  status     String   @default("PENDING")
  retryCount Int      @default(0)
  lastError  String?
  // Posé à true quand l'échec vient d'un vrai conflit (409/ConflictError côté serveur) plutôt
  // que d'une coupure réseau ou d'une erreur de validation — distingue les deux dans l'UI.
  conflict   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Un curseur par type d'entité pour la synchro descendante (serveur → local, §6.2 du plan) :
// jusqu'où on est déjà allé, pour ne redemander au serveur que ce qui a changé depuis.
model SyncCursor {
  entityType   String    @id
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// --- Mode hors-ligne — Phase 1 : Patients (voir Plan-Mode-Hors-Ligne-Synchronisation.md) --------
// Miroir local volontairement limité aux champs de la liste + de la création/modification
// (`PatientSummary`/`CreatePatientInput`/`UpdatePatientInput`) — PAS aux vues agrégées du dossier
// patient (consultations, vitaux, ordonnances, résultats, chronologie), qui restent en ligne
// uniquement pour cette phase (elles agrègent 5+ domaines cliniques, hors périmètre réaliste
// d'un seul chantier). `id` n'a pas de `@default(uuid())` : l'id est décidé par l'application
// (généré côté client à la création hors-ligne, ou recopié depuis le serveur à la synchro
// descendante) plutôt que par la base locale elle-même. `syncStatus` ∈ SYNCED | PENDING — un
// patient PENDING porte un code provisoire (`P-LOCAL-xxxx`) tant que la création n'a pas été
// confirmée par le serveur (voir §5 du plan, option A).
model Patient {
  id                    String    @id
  code                  String    @unique
  firstName             String
  lastName              String
  gender                String
  birthDate             DateTime
  phone                 String?
  email                 String?
  bloodType             String?
  allergies             String?
  status                String    @default("ACTIVE")
  admissionType         String    @default("AMBULATOIRE")
  service               String?
  insuranceProvider     String?
  insuranceNumber       String?
  insuranceExpiry       DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  serverUpdatedAt       DateTime?
  syncStatus            String    @default("SYNCED")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
}

// --- Mode hors-ligne — Phase 1 : Consultations, Rendez-vous, Urgences ---------------------------
// Même principe que Patient ci-dessus : miroir limité aux champs de liste/création/modification,
// `id` décidé par l'application, `syncStatus` PENDING tant qu'une création/modification locale
// n'a pas été confirmée par le serveur. `doctorName` est un champ propre au miroir local (absent
// du schéma serveur) : un instantané du nom affiché la dernière fois qu'on l'a vu, pour continuer
// à l'afficher hors-ligne même sans miroir local du domaine RH — jamais réenvoyé au serveur.
// Consultations est le seul des trois avec un code lisible (`dossier`, généré par `nextCode` côté
// serveur) : reçoit donc un code provisoire `DOS-LOCAL-xxxx` comme Patient (§5 du plan, option A).

model Consultation {
  id              String    @id
  dossier         String    @unique
  date            DateTime
  service         String?
  motive          String?
  status          String    @default("EN_ATTENTE")
  patientId       String?
  patientName     String?
  patientCode     String?
  patientAge      Int?
  patientGender   String?
  doctorId        String?
  doctorName      String?
  documentFileName String?
  documentMimeType String?
  documentFileSize Int?
  serverUpdatedAt DateTime?
  syncStatus      String    @default("SYNCED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model Appointment {
  id              String    @id
  date            DateTime
  durationMin     Int       @default(30)
  service         String?
  room            String?
  type            String    @default("CONSULTATION")
  motive          String?
  status          String    @default("CONFIRME")
  reminder        String?
  patientId       String?
  patientName     String?
  patientAge      Int?
  doctorId        String?
  doctorName      String?
  serverUpdatedAt DateTime?
  syncStatus      String    @default("SYNCED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model EmergencyVisit {
  id              String    @id
  arrivalTime     DateTime
  dischargeTime   DateTime?
  motive          String?
  detail          String?
  severity        String
  zone            String?
  status          String    @default("EN_ATTENTE_TRIAGE")
  outcome         String?
  patientId       String?
  patientName     String?
  patientCode     String?
  patientAge      Int?
  patientGender   String?
  doctorId        String?
  doctorName      String?
  serverUpdatedAt DateTime?
  syncStatus      String    @default("SYNCED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

