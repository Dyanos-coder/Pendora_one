// --- Mode hors-ligne — Phase 3 : Stocks, Approvisionnement, Finance, RH (voir
// Plan-Mode-Hors-Ligne-Synchronisation.md) --------------------------------------------------------
// Dernière phase, périmètre volontairement limité à l'entité PRINCIPALE de chaque domaine (celle
// des items 1-11) — PAS aux nombreux sous-onglets CRUD ajoutés aux items 12-14 (mouvements de
// stock, commandes/réceptions, factures/paiements/budgets/comptes, présences/contrats/paie/
// documents RH), qui restent en ligne uniquement pour l'instant. `depotName` (Stocks) est un
// instantané local (comme `doctorName` en Phase 1/2) — `Depot` est un référentiel en lecture seule
// côté serveur, pas de miroir dédié. `Employee` n'a pas de `deletedAt` côté serveur (suppression
// douce via `isActive: false`, cf. item 6) — le miroir local suit la même convention plutôt que
// d'en inventer une nouvelle.

model DepotItem {
  id              String    @id
  name            String
  category        String
  depotId         String
  depotName       String?
  available       Int
  minThreshold    Int
  lastMovementAt  DateTime?
  serverUpdatedAt DateTime?
  syncStatus      String    @default("SYNCED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

// Sous-onglets Stocks (item 16, hors périmètre de la Phase 3 initiale — voir
// Plan-Mode-Hors-Ligne-Synchronisation.md, section ajoutée après coup). `itemName`/`fromItemName`/
// `toDepotName` sont des instantanés (même principe que `DepotItem.depotName`), pas de relation
// Prisma locale — recopiés depuis le miroir local `DepotItem` au moment de la création hors-ligne,
// remplacés par la valeur serveur à la synchro.
model StockMovement {
  id              String    @id
  reference       String    @unique
  itemId          String
  itemName        String?
  type            String
  quantity        Int
  movementDate    DateTime
  reason          String?
  performedBy     String
  note            String?
  serverUpdatedAt DateTime?
  syncStatus      String    @default("SYNCED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model StockTransfer {
  id              String    @id
  reference       String    @unique
  fromItemId      String
  fromItemName    String?
  toDepotId       String
  toDepotName     String?
  quantity        Int
  transferDate    DateTime
  performedBy     String
  note            String?
  serverUpdatedAt DateTime?
  syncStatus      String    @default("SYNCED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model InventoryCount {
  id               String    @id
  reference        String    @unique
  itemId           String
  itemName         String?
