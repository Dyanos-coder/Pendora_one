// Pandora One — Backend
// Une instance app-server + une base MySQL par entreprise (pas de multi-tenant partagé) :
// cette base entière appartient à une seule entreprise, donc pas de tenantId à porter sur
// chaque table.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// Table à une seule ligne : les informations de l'entreprise qui possède cette instance.
model Company {
  id           String   @id @default(uuid())
  name         String
  sector       String?
  logo         Bytes?   @db.LongBlob
  logoMimeType String?
  createdAt    DateTime @default(now())

  @@map("company")
}

enum Role {
  DIRIGEANT
  EMPLOYE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("user")
}

// Journal append-only (§3.8) : pas de méthode update/delete exposée par les services.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     String?  @db.Text
  after      String?  @db.Text
  createdAt  DateTime @default(now())

  @@map("auditlog")
}

enum InvoiceStatus {
  PAYE
  EN_ATTENTE
  EN_RETARD
}

model Invoice {
  id            String        @id @default(uuid())
  reference     String
  description   String
  partyName     String
  amount        Int
  status        InvoiceStatus
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  photo         Bytes?        @db.LongBlob
  photoMimeType String?

  @@map("invoice")
}

// Historique des conversations avec l'assistant "Mémoire d'entreprise" (§ IA).
model MemoryConversation {
  id        String          @id @default(uuid())
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  MemoryMessage[]

  @@map("memory_conversation")
}

enum MemoryMessageRole {
  USER
  ASSISTANT
}

model MemoryMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   MemoryConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MemoryMessageRole
  text           String             @db.Text
  createdAt      DateTime           @default(now())

  @@index([conversationId])
  @@map("memory_message")
}

enum SaleStatus {
  PAYE
  EN_ATTENTE
}

model Sale {
  id          String     @id @default(uuid())
  clientName  String
  stockItemId String
  stockItem   StockItem  @relation(fields: [stockItemId], references: [id])
  quantity    Int
  items       String
  amount      Int
  status      SaleStatus
  issuedAt    DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([stockItemId])
  @@map("sale")
}

model StockItem {
  id        String   @id @default(uuid())
  name      String
  sku       String   @unique
  category  String
  quantity  Int
  threshold Int
  unitPrice Int
  createdAt DateTime @default(now())
  sales     Sale[]

  @@map("stock_item")
}
