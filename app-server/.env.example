## Renseigne ces valeurs avec ce que ton hébergeur MySQL te donne (ex: Hostinger hPanel) —
## les mêmes champs que ceux utilisés pour se connecter via phpMyAdmin.
DB_HOST=host
DB_PORT=3306
DB_NAME=pandora_one
DB_USER=user
DB_PASSWORD=password

PORT=3000

## Secret utilisé pour signer les jetons de session (JWT) — génère une vraie valeur aléatoire
## et longue en production (ex: `openssl rand -hex 32`), ne réutilise jamais celle par défaut.
JWT_SECRET=change-me-to-a-long-random-value
